{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://public-meeting-forum.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://public-meeting-forum.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
